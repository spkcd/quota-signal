{
  "manifest_version": 3,
  "name": "Quota Signal for Claude",
  "version": "1.4.0",
  "description": "Refresh verified Claude workspaces in Quota Signal.",
  "permissions": [
    "alarms",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Quota Signal \u00b7 Refresh Claude Usage"
  },
  "key": ""
}
